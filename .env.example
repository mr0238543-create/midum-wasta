# انسخ هذا الملف إلى .env.local واملأ القيم من: Supabase ← Project Settings ← API
# مهم: المفتاح المستخدم هنا هو anon (العام) فقط. لا تضع service_role هنا أبدًا.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# بريد التواصل الظاهر في سياسة الخصوصية والشروط (بريد حقيقي تراقبه)
VITE_CONTACT_EMAIL=
